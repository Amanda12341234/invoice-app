# Google Gemini API Key（從 Google AI Studio 取得，免費額度）
GEMINI_API_KEY=your_gemini_api_key_here

# 速率限制：每分鐘最大請求數（對應 Gemini 免費層 15 RPM）
RATE_LIMIT_RPM=15

# 每日 Gemini API 請求上限（免費層 1500 RPD）
DAILY_LIMIT=1500

# Ollama 服務位址（備援 LLM，本機執行）
OLLAMA_URL=http://localhost:11434/api/generate

# Ollama 使用的模型（需先執行 ollama pull llama3）
OLLAMA_MODEL=llama3

# 上傳圖片大小上限（MB）
MAX_FILE_SIZE_MB=10

# 辨識佇列最大容量（超過此數量回傳 503）
QUEUE_MAX_SIZE=100
